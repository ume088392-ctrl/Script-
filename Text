    b.Text = enabled and "💀 ANTI-BANG2: ON" or "💀 ANTI-BANG: OFF"

    if enabled then
        task.spawn(function()
            while b:GetAttribute("AntiBang") do
                pcall(function()
                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")

                    if hrp then
                        local oldCFrame = hrp.CFrame

                        hrp.CFrame = oldCFrame * CFrame.new(0, 1000, 0)
                        task.wait(0.1)

                        if hrp and hrp.Parent then
                            hrp.CFrame = oldCFrame
                        end
                    end
                end)

                task.wait(0.1)
            end
        end)
    end
end)

